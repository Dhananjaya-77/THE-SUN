generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── AUTH & USERS ────────────────────────────────────────────

enum Role {
  ADMIN
  OPERATOR
  ENGINEER
  READONLY
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  password      String
  firstName     String    @map("first_name")
  lastName      String    @map("last_name")
  role          Role      @default(READONLY)
  isActive      Boolean   @default(true) @map("is_active")
  lastLoginAt   DateTime? @map("last_login_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  sessions      Session[]
  auditLogs     AuditLog[]
  controlActions ControlAction[]
  siteScopes    UserSiteScope[]
  notifications UserNotification[]

  @@map("users")
}

model Session {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  refreshToken String   @unique @map("refresh_token")
  userAgent    String?  @map("user_agent")
  ipAddress    String?  @map("ip_address")
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model UserSiteScope {
  id     String @id @default(uuid())
  userId String @map("user_id")
  siteId String @map("site_id")

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  site SolarSite @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([userId, siteId])
  @@map("user_site_scopes")
}

// ─── AUDIT ───────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  action    String
  resource  String
  resourceId String? @map("resource_id")
  details   Json?
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId])
  @@map("audit_logs")
}

// ─── SOLAR SITES ─────────────────────────────────────────────

enum SiteStatus {
  ONLINE
  OFFLINE
  ATTENTION
  MAINTENANCE
}

model SolarSite {
  id                    String     @id @default(uuid())
  siteCode              String     @unique @map("site_code")
  name                  String
  country               String     @default("Sri Lanka")
  district              String?
  province              String?
  location              String?
  latitude              Float?
  longitude             Float?
  technology            String     @default("Ground-mounted Solar PV")
  commissionedYear      Int?       @map("commissioned_year")
  installedCapacityMw   Float      @map("installed_capacity_mw")
  annualEnergyGwh       Float?     @map("annual_energy_gwh")
  status                SiteStatus @default(ONLINE)
  dataSource            String     @default("PUBLIC_REFERENCE") @map("data_source")
  sourceUrl             String?    @map("source_url")
  imageUrl              String?    @map("image_url")
  createdAt             DateTime   @default(now()) @map("created_at")
  updatedAt             DateTime   @updatedAt @map("updated_at")

  measurements Measurement[]
  batteries    Battery[]
  inverters    Inverter[]
  iotDevices   IotDevice[]
  alerts       Alert[]
  userScopes   UserSiteScope[]

  @@map("solar_sites")
}

// ─── MEASUREMENTS & TELEMETRY ────────────────────────────────

enum DataQuality {
  GOOD
  SUSPECT
  BAD
  INTERPOLATED
}

model Measurement {
  id              String      @id @default(uuid())
  siteId          String      @map("site_id")
  timestamp       DateTime
  generationKw    Float?      @map("generation_kw")
  gridVoltageV    Float?      @map("grid_voltage_v")
  activePowerKw   Float?      @map("active_power_kw")
  reactivePowerKvar Float?    @map("reactive_power_kvar")
  frequencyHz     Float?      @map("frequency_hz")
  powerFactor     Float?      @map("power_factor")
  currentA        Float?      @map("current_a")
  irradianceWm2   Float?      @map("irradiance_wm2")
  ambientTempC    Float?      @map("ambient_temp_c")
  dataSource      String      @default("SIMULATED") @map("data_source")
  dataQuality     DataQuality @default(GOOD) @map("data_quality")

  site SolarSite @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, timestamp])
  @@map("measurements")
}

// ─── BATTERY STORAGE ─────────────────────────────────────────

enum BatteryStatus {
  AVAILABLE
  CHARGING
  DISCHARGING
  OFFLINE
  MAINTENANCE
}

model Battery {
  id              String        @id @default(uuid())
  siteId          String        @map("site_id")
  name            String
  capacityKwh     Float         @map("capacity_kwh")
  maxPowerKw      Float         @map("max_power_kw")
  socPercent      Float         @default(0) @map("soc_percent")
  sohPercent      Float         @default(100) @map("soh_percent")
  temperatureC    Float?        @map("temperature_c")
  cycleCount      Int           @default(0) @map("cycle_count")
  status          BatteryStatus @default(AVAILABLE)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  site      SolarSite         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  schedules BatterySchedule[]

  @@map("batteries")
}

model BatterySchedule {
  id          String   @id @default(uuid())
  batteryId   String   @map("battery_id")
  startTime   String   @map("start_time")
  endTime     String   @map("end_time")
  action      String   // CHARGE, DISCHARGE, IDLE
  powerKw     Float    @map("power_kw")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  battery Battery @relation(fields: [batteryId], references: [id], onDelete: Cascade)

  @@map("battery_schedules")
}

// ─── INVERTERS ───────────────────────────────────────────────

model Inverter {
  id              String   @id @default(uuid())
  siteId          String   @map("site_id")
  name            String
  ratedPowerKw    Float    @map("rated_power_kw")
  efficiencyPct   Float    @default(98) @map("efficiency_pct")
  status          String   @default("ONLINE")
  createdAt       DateTime @default(now()) @map("created_at")

  site SolarSite @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@map("inverters")
}

// ─── GRID MANAGEMENT ─────────────────────────────────────────

model GridSnapshot {
  id               String   @id @default(uuid())
  timestamp        DateTime @default(now())
  converged        Boolean
  netImportKw      Float    @map("net_import_kw")
  voltagesJson     Json     @map("voltages_json")
  violationsJson   Json?    @map("violations_json")
  lineLoadingJson  Json?    @map("line_loading_json")
  scenarioName     String?  @map("scenario_name")

  @@index([timestamp])
  @@map("grid_snapshots")
}

// ─── CONTROL ENGINE ──────────────────────────────────────────

enum ControlStatus {
  PENDING
  AUTHORIZED
  REJECTED
  EXECUTED
  FAILED
}

model ControlAction {
  id              String        @id @default(uuid())
  type            String
  description     String
  constraintValue String?       @map("constraint_value")
  candidateTarget String?       @map("candidate_target")
  setpoint        String?
  safetyChecks    Json?         @map("safety_checks")
  status          ControlStatus @default(PENDING)
  authorizedBy    String?       @map("authorized_by")
  authorizedAt    DateTime?     @map("authorized_at")
  executedAt      DateTime?     @map("executed_at")
  aiAssisted      Boolean       @default(false) @map("ai_assisted")
  createdAt       DateTime      @default(now()) @map("created_at")

  authorizer User? @relation(fields: [authorizedBy], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@map("control_actions")
}

// ─── FORECASTING ─────────────────────────────────────────────

model Forecast {
  id              String   @id @default(uuid())
  type            String   // GENERATION, LOAD, IRRADIANCE
  targetDate      DateTime @map("target_date")
  values          Json     // Array of hourly values
  confidencePct   Float?   @map("confidence_pct")
  modelVersion    String?  @map("model_version")
  weatherInputs   Json?    @map("weather_inputs")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([targetDate])
  @@map("forecasts")
}

// ─── IOT & DEVICES ───────────────────────────────────────────

enum DeviceStatus {
  ONLINE
  DEGRADED
  OFFLINE
}

model IotDevice {
  id            String       @id @default(uuid())
  siteId        String?      @map("site_id")
  deviceCode    String       @unique @map("device_code")
  name          String
  type          String       // GATEWAY, SENSOR, METER, INVERTER_MONITOR
  protocol      String       @default("MQTT") // MQTT, MODBUS, REST
  ipAddress     String?      @map("ip_address")
  firmwareVer   String?      @map("firmware_ver")
  status        DeviceStatus @default(ONLINE)
  lastSeenAt    DateTime?    @map("last_seen_at")
  latencyMs     Float?       @map("latency_ms")
  packetLossPct Float?       @map("packet_loss_pct")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  site SolarSite? @relation(fields: [siteId], references: [id], onDelete: SetNull)

  @@map("iot_devices")
}

// ─── ALERTS & EVENTS ─────────────────────────────────────────

enum AlertSeverity {
  CRITICAL
  WARNING
  INFO
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  INVESTIGATING
  RESOLVED
}

model Alert {
  id          String        @id @default(uuid())
  siteId      String?       @map("site_id")
  severity    AlertSeverity
  title       String
  detail      String?
  status      AlertStatus   @default(OPEN)
  acknowledgedBy String?    @map("acknowledged_by")
  resolvedAt  DateTime?     @map("resolved_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  site SolarSite? @relation(fields: [siteId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([severity])
  @@map("alerts")
}

// ─── AI INTELLIGENCE ─────────────────────────────────────────

model AiModel {
  id             String   @id @default(uuid())
  name           String
  type           String   // FORECAST, ANOMALY, OPTIMIZATION
  version        String
  status         String   @default("READY")
  accuracy       Float?
  inferenceMs    Float?   @map("inference_ms")
  lastTrainedAt  DateTime? @map("last_trained_at")
  configJson     Json?    @map("config_json")
  createdAt      DateTime @default(now()) @map("created_at")

  anomalies AiAnomaly[]

  @@map("ai_models")
}

model AiAnomaly {
  id          String   @id @default(uuid())
  modelId     String   @map("model_id")
  siteId      String?  @map("site_id")
  type        String
  description String
  severity    String
  confidence  Float
  detectedAt  DateTime @default(now()) @map("detected_at")
  resolvedAt  DateTime? @map("resolved_at")

  model AiModel @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@map("ai_anomalies")
}

model AiRecommendation {
  id          String   @id @default(uuid())
  type        String
  title       String
  description String
  impact      String?
  status      String   @default("PENDING")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("ai_recommendations")
}

// ─── REPORTS ─────────────────────────────────────────────────

model Report {
  id           String   @id @default(uuid())
  name         String
  type         String   // FLEET_SUMMARY, REGULATORY, PERFORMANCE, CUSTOM
  format       String   @default("PDF") // PDF, CSV
  parameters   Json?
  generatedUrl String?  @map("generated_url")
  status       String   @default("PENDING")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("reports")
}

model ReportSchedule {
  id         String   @id @default(uuid())
  reportType String   @map("report_type")
  cronExpr   String   @map("cron_expr")
  recipients Json?
  isActive   Boolean  @default(true) @map("is_active")
  lastRunAt  DateTime? @map("last_run_at")
  nextRunAt  DateTime? @map("next_run_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@map("report_schedules")
}

// ─── INTEGRATIONS ────────────────────────────────────────────

enum IntegrationStatus {
  CONNECTED
  SYNCING
  ATTENTION
  DISCONNECTED
}

model Integration {
  id          String            @id @default(uuid())
  name        String
  type        String            // REST, MQTT, MODBUS_TCP
  endpoint    String?
  status      IntegrationStatus @default(CONNECTED)
  configJson  Json?             @map("config_json")
  lastSyncAt  DateTime?         @map("last_sync_at")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  @@map("integrations")
}

// ─── NOTIFICATIONS ───────────────────────────────────────────

model Notification {
  id        String   @id @default(uuid())
  type      String   // CRITICAL, WARNING, INFO
  title     String
  detail    String?
  targetView String? @map("target_view")
  createdAt DateTime @default(now()) @map("created_at")

  userNotifications UserNotification[]

  @@index([createdAt])
  @@map("notifications")
}

model UserNotification {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  notificationId String   @map("notification_id")
  isRead         Boolean  @default(false) @map("is_read")
  readAt         DateTime? @map("read_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([userId, notificationId])
  @@map("user_notifications")
}

// ─── RESIDENTIAL SOLAR ───────────────────────────────────────

enum NetScheme {
  NET_METERING
  NET_ACCOUNTING
  NET_PLUS
  NET_PLUS_PLUS
}

enum UtilityProvider {
  CEB
  LECO
}

model ResidentialCustomer {
  id              String          @id @default(uuid())
  displayCode     String          @unique @map("display_code")
  firstName       String?         @map("first_name")
  lastName        String?         @map("last_name")
  utilityProvider UtilityProvider @map("utility_provider")
  createdAt       DateTime        @default(now()) @map("created_at")

  sites ResidentialSite[]

  @@map("residential_customers")
}

model ResidentialSite {
  id               String    @id @default(uuid())
  customerId       String    @map("customer_id")
  siteCode         String    @unique @map("site_code")
  district         String?
  province         String?
  latitude         Float?
  longitude        Float?
  connectionScheme NetScheme @map("connection_scheme")
  status           String    @default("ACTIVE")
  dataSource       String    @default("SIMULATED") @map("data_source")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  customer       ResidentialCustomer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  solarSystem    ResidentialSolarSystem?
  measurements   ResidentialMeasurement[]
  energyCredits  ResidentialEnergyCredit[]

  @@map("residential_sites")
}

model ResidentialSolarSystem {
  id                String @id @default(uuid())
  siteId            String @unique @map("site_id")
  solarCapacityKw   Float  @map("solar_capacity_kw")
  panelCount        Int?   @map("panel_count")
  panelWattageW     Int?   @map("panel_wattage_w")
  inverterCapacityKw Float? @map("inverter_capacity_kw")
  connectionPhase   String? @map("connection_phase")
  maxExportKw       Float?  @map("max_export_kw")
  hasBattery        Boolean @default(false) @map("has_battery")
  batteryCapacityKwh Float? @map("battery_capacity_kwh")

  site ResidentialSite @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@map("residential_solar_systems")
}

model ResidentialMeasurement {
  id                    String      @id @default(uuid())
  siteId                String      @map("site_id")
  timestamp             DateTime
  solarGenerationKw     Float?      @map("solar_generation_kw")
  householdConsumptionKw Float?     @map("household_consumption_kw")
  gridImportKw          Float?      @map("grid_import_kw")
  gridExportKw          Float?      @map("grid_export_kw")
  voltageV              Float?      @map("voltage_v")
  frequencyHz           Float?      @map("frequency_hz")
  batterySocPct         Float?      @map("battery_soc_pct")
  dataSource            String      @default("SIMULATED") @map("data_source")
  dataQuality           DataQuality @default(GOOD) @map("data_quality")

  site ResidentialSite @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, timestamp])
  @@map("residential_measurements")
}

model ResidentialEnergyCredit {
  id             String @id @default(uuid())
  siteId         String @map("site_id")
  billingPeriod  String @map("billing_period")
  exportedKwh    Float  @map("exported_kwh")
  creditedKwh    Float  @map("credited_kwh")
  exportValueLkr Float  @map("export_value_lkr")

  site ResidentialSite @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@map("residential_energy_credits")
}

// ─── SIMULATION / DIGITAL TWIN ───────────────────────────────

model SimulationScenario {
  id            String   @id @default(uuid())
  name          String
  description   String?
  inputsJson    Json     @map("inputs_json")
  resultsJson   Json?    @map("results_json")
  converged     Boolean?
  accuracy      Float?
  status        String   @default("PENDING")
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("simulation_scenarios")
}
