{
  "name": "the-sun",
  "version": "1.0.0",
  "description": "The Sun - SolarGrid LK Integrated Solar Management Platform",
  "private": true,
  "scripts": {
    "dev": "npm run dev:all",
    "dev:all": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "cd backend && npm run build",
    "build:frontend": "cd frontend && npm run build",
    "seed": "cd backend && npm run seed",
    "prisma:generate": "cd backend && npm run prisma:generate",
    "prisma:studio": "cd backend && npm run prisma:studio",
    "simulate:sites": "python3 device-simulator/site_simulation.py",
    "simulate:grid": ".venv/bin/python power-system/network_model.py"
  },
  "devDependencies": {
    "concurrently": "^10.0.7"
  }
}
